# MANIFEST.in file
include requirements.txt
include README.md
include LICENSE
include THIRD_PARTY_NOTICES.md

recursive-include src *
prune **/__pycache__
prune docs
prune tests
prune tools
prune .idea
prune .github
global-exclude *.log
global-exclude *upx.exe
global-exclude *update.exe
global-exclude *.so
global-exclude *.dylib
global-exclude *.pyd
global-exclude *.dll
global-exclude src/NepTrainKit/src/**
global-exclude src/NepTrainKit/src.qrc
