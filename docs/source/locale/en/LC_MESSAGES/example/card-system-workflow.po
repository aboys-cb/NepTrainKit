#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/example/card-system-workflow.md:41
#: 680f8dd9d2ee47d2b35a078b75d096e2
msgid "`Super Cell`"
msgstr "`Super Cell`"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/example/card-system-workflow.md:41
#: b0d641d05d664bd8ac1efe395365b12e
