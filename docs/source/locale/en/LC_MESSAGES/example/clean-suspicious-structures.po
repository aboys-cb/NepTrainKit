#: 75d38fec46ad4a7c8f53de00c68a060e
msgid "净力阈值设置窗口"
msgstr "Net-force threshold dialog"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/example/clean-suspicious-structures.md:18
#: 75d38fec46ad4a7c8f53de00c68a060e
