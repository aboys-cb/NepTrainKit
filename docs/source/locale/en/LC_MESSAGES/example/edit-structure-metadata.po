msgid "弹窗顶部列出选中结构共有的标签："
msgstr "The top of the dialog lists tags shared by the selected structures:"

#: ../../source/example/edit-structure-metadata.md:16
#: 727ec15afcad4921a2e37671e15d8446
msgid "编辑结构元数据窗口"
msgstr "Structure metadata editor"

#: ../../source/example/edit-structure-metadata.md:16
