msgid "最小工作流分四步："
msgstr "The shortest workflow has four steps:"

#: ../../source/index.rst:24 6682974b7f2e4444803b76bdd0d37da1
msgid "先导入初始结构。"
msgstr "Import the starting structures."

#: ../../source/index.rst:25 534d2d6611084f03b541577d5a1dca10
msgid "添加一张生成或变换卡片。"
msgstr "Add a generation or transformation card."

