#: ../../source/module/custom-card-development.md:35
#: 532ee1c0be4e44e6bdacf9bf3a0a6be3
msgid "第二步：写 Params dataclass"
msgstr "Step 2: Define the Params dataclass"

#: ../../source/module/custom-card-development.md:37
#: 14d3107c76db4ad89be4b3919f005ce3
msgid ""
"在 `src/NepTrainKit/core/cards/` 对应模块（`lattice.py` / `alloy.py` / "
"`defect.py` / `magnetism.py` / `structure.py` / `filter.py`）中定义："
msgstr ""
"Define it in the appropriate module under `src/NepTrainKit/core/cards/` "
"(`lattice.py`, `alloy.py`, `defect.py`, `magnetism.py`, `structure.py`, "
"or `filter.py`):"

#: ../../source/module/custom-card-development.md:39
#: 76f522d9092d4107b756672cc1e5dcfd
msgid ""
"from dataclasses import dataclass\n"
"\n"
"@dataclass(frozen=True)\n"
"class MyCardParams:\n"
"    \"\"\"Parameters for my card.\"\"\"\n"
"    param_a: str = \"default\"\n"
"    param_b: float = 1.0\n"
"    use_seed: bool = False\n"
"    seed: int = 0\n"
msgstr ""
"from dataclasses import dataclass\n"
"\n"
"@dataclass(frozen=True)\n"
"class MyCardParams:\n"
"    \"\"\"Parameters for my card.\"\"\"\n"
"    param_a: str = \"default\"\n"
"    param_b: float = 1.0\n"
"    use_seed: bool = False\n"
"    seed: int = 0\n"

#: ../../source/module/custom-card-development.md:51
#: 8011327467c54672924a082b363d815e
msgid "必须是 frozen dataclass"
msgstr "Use a frozen dataclass."

#: ../../source/module/custom-card-development.md:52
#: 9badfe40a9824f62aa262d8a9116f490
msgid "每个字段给默认值"
msgstr "Give every field a default value."

#: ../../source/module/custom-card-development.md:53
#: b8db9c15087a473badcd97b44fc27275
msgid "命名用下划线，和 UI 控件的 `get_params()` key 一致"
msgstr ""
"Use snake_case names that match the keys returned by the UI's "
"`get_params()` method."

#: ../../source/module/custom-card-development.md:55
#: f89e7b1a3a1649cf936e8c8b73de6fbb
msgid "第三步：写 Operation"
msgstr "Step 3: Implement the operation"

#: ../../source/module/custom-card-development.md:57
#: 76b10ee7140542fbacd72b9827f74a17
msgid "同文件内："
msgstr "In the same module:"

#: ../../source/module/custom-card-development.md:59
#: 08e9083f62eb47489a846072c23d192e
msgid ""
"from .operation import StructureOperation  # 或 DatasetOperation / "
"GeneratorOperation\n"
"\n"
"class MyCardOperation(StructureOperation):\n"
"    \"\"\"Pure logic for my card.\"\"\"\n"
"\n"
"    def run_structure(self, structure, params: MyCardParams) -> list:\n"
"        # 校验\n"
"        if params.param_b <= 0:\n"
"            raise ValueError(\"param_b must be > 0\")\n"
"\n"
"        # 纯算法逻辑\n"
"        new_structure = structure.copy()\n"
"        # ... do something with params ...\n"
"        append_config_tag(new_structure, f\"MyTag(...)\")\n"
"        return [new_structure]\n"
msgstr ""
"from .operation import StructureOperation  # or DatasetOperation / "
"GeneratorOperation\n"
"\n"
"class MyCardOperation(StructureOperation):\n"
"    \"\"\"Pure logic for my card.\"\"\"\n"
"\n"
"    def run_structure(self, structure, params: MyCardParams) -> list:\n"
"        # Validate parameters.\n"
"        if params.param_b <= 0:\n"
"            raise ValueError(\"param_b must be > 0\")\n"
"\n"
"        # Keep the algorithm here.\n"
"        new_structure = structure.copy()\n"
"        # ... do something with params ...\n"
"        append_config_tag(new_structure, f\"MyTag(...)\")\n"
"        return [new_structure]\n"

#: ../../source/module/custom-card-development.md:77
#: a63eef04e7e84eb9acb15ac673f17243
msgid "规则："
msgstr "Rules:"

#: ../../source/module/custom-card-development.md:78
#: d787a9e5879b49c4be154f8127af7353
msgid "不 import UI 库"
msgstr "Do not import UI libraries."

#: ../../source/module/custom-card-development.md:79
#: 2ff1bfe4765f466692a09da9df849231
msgid "参数校验失败抛异常"
msgstr "Raise an exception when parameter validation fails."

#: ../../source/module/custom-card-development.md:80
#: b8949d968c0a4278920889d10bd03d44
msgid "用 `append_config_tag` 写可追溯标签"
msgstr "Use `append_config_tag` to add a traceable label."

#: ../../source/module/custom-card-development.md:81
#: 9c1aa522457848f2b85e8d008d6be84b
msgid "不做静默回退"
msgstr "Do not silently fall back to another behavior."

#: ../../source/module/custom-card-development.md:83
#: 9583f1eec6e44d4789c605d21e399b7a
msgid "第四步：写 UI 卡片"
msgstr "Step 4: Implement the UI card"

#: ../../source/module/custom-card-development.md:85
#: 5796821aecb44c298e809c3aa67e56b3
msgid "在 `src/NepTrainKit/ui/views/_card/` 新建文件，继承 `MakeDataCard`："
msgstr ""
"Create a module under `src/NepTrainKit/ui/views/_card/` and inherit from "
"`MakeDataCard`:"

#: ../../source/module/custom-card-development.md:87
#: e3be26c6c763408fbb422996d41141db
msgid ""
"from PySide6.QtWidgets import QFrame\n"
"from qfluentwidgets import BodyLabel, ComboBox, CheckBox\n"
"from NepTrainKit.core import CardManager\n"
"from NepTrainKit.core.cards.xxx import MyCardOperation, MyCardParams\n"
"from NepTrainKit.core.cards.operation import params_to_dict\n"
"from NepTrainKit.ui.widgets import SpinBoxUnitInputFrame, MakeDataCard\n"
"\n"
"@CardManager.register_card\n"
"class MyCard(MakeDataCard):\n"
"    group = \"MyGroup\"\n"
"    card_name = \"My Card\"\n"
"    menu_icon = r\":/images/src/images/my_icon.svg\"\n"
"\n"
"    def __init__(self, parent=None):\n"
"        super().__init__(parent)\n"
"        self.init_ui()\n"
"\n"
"    def init_ui(self):\n"
"        # 构建控件\n"
"        ...\n"
"\n"
"    # ---- 必须实现的三个方法 ----\n"
"\n"
"    def create_operation(self):\n"
"        return MyCardOperation()\n"
"\n"
"    def get_params(self) -> MyCardParams:\n"
"        return MyCardParams(\n"
"            param_a=self.combo.currentText(),\n"
"            param_b=float(self.spinbox.get_input_value()[0]),\n"
"            ...\n"
"        )\n"
"\n"
"    def set_params(self, params: MyCardParams) -> None:\n"
"        self.combo.setText(params.param_a)\n"
"        self.spinbox.set_input_value([params.param_b])\n"
"        ...\n"
"\n"
"    # ---- 序列化（必须实现） ----\n"
"\n"
"    def to_dict(self):\n"
"        data = super().to_dict()\n"
"        data[\"params\"] = params_to_dict(self.get_params())\n"
"        return data\n"
"\n"
"    def from_dict(self, data):\n"
"        super().from_dict(data)\n"
"        raw = data.get(\"params\")\n"
"        if raw is not None:\n"
"            params = MyCardParams(**raw)\n"
"        else:\n"
"            params = MyCardParams()  # 全部默认值\n"
"        self.set_params(params)\n"
msgstr ""
"from PySide6.QtWidgets import QFrame\n"
"from qfluentwidgets import BodyLabel, ComboBox, CheckBox\n"
"from NepTrainKit.core import CardManager\n"
"from NepTrainKit.core.cards.xxx import MyCardOperation, MyCardParams\n"
"from NepTrainKit.core.cards.operation import params_to_dict\n"
"from NepTrainKit.ui.widgets import SpinBoxUnitInputFrame, MakeDataCard\n"
"\n"
"@CardManager.register_card\n"
"class MyCard(MakeDataCard):\n"
"    group = \"MyGroup\"\n"
"    card_name = \"My Card\"\n"
"    menu_icon = r\":/images/src/images/my_icon.svg\"\n"
"\n"
"    def __init__(self, parent=None):\n"
"        super().__init__(parent)\n"
"        self.init_ui()\n"
"\n"
"    def init_ui(self):\n"
"        # Construct the widgets.\n"
"        ...\n"
"\n"
"    # ---- The three required methods ----\n"
"\n"
"    def create_operation(self):\n"
"        return MyCardOperation()\n"
"\n"
"    def get_params(self) -> MyCardParams:\n"
"        return MyCardParams(\n"
"            param_a=self.combo.currentText(),\n"
"            param_b=float(self.spinbox.get_input_value()[0]),\n"
"            ...\n"
"        )\n"
"\n"
"    def set_params(self, params: MyCardParams) -> None:\n"
"        self.combo.setText(params.param_a)\n"
"        self.spinbox.set_input_value([params.param_b])\n"
"        ...\n"
"\n"
"    # ---- Serialization is also required. ----\n"
"\n"
"    def to_dict(self):\n"
"        data = super().to_dict()\n"
"        data[\"params\"] = params_to_dict(self.get_params())\n"
"        return data\n"
"\n"
"    def from_dict(self, data):\n"
"        super().from_dict(data)\n"
"        raw = data.get(\"params\")\n"
"        if raw is not None:\n"
"            params = MyCardParams(**raw)\n"
"        else:\n"
"            params = MyCardParams()  # Use all defaults.\n"
"        self.set_params(params)\n"

#: ../../source/module/custom-card-development.md:143
#: ade5cb7a639d4cb3964afa519682942e
msgid ""
"**只在迁移旧卡片时才从旧 key 恢复**。上面的模板是新卡写法，`from_dict` 只读 "
"`params`。如果你在迁移一张已有用户的旧卡片，可以在 `else` 分支里从 `data[\"old_key\"]` 等旧字段构造 "
"Params 以保证向后兼容。"
msgstr ""
"**Read legacy keys only when migrating an existing card.** The template "
"above is for a new card, so `from_dict` reads only `params`. When "
"migrating a card already present in saved user workflows, the `else` "
"branch may construct Params from legacy fields such as "
"`data[\"old_key\"]` to preserve backward compatibility."

#: ../../source/module/custom-card-development.md:145
#: e21aee5b559b4bc0acac5769ab986614
msgid "关键规则"
msgstr "Key rules"

#: ../../source/module/custom-card-development.md:147
#: c031a982f3934ea0b0a38b14e0e30aba
msgid "**禁止覆盖 `run()`**：基类已根据 `create_operation()` 返回的类型自动分发到正确线程。"
msgstr ""
"**Do not override `run()`.** The base class dispatches work to the "
"correct thread from the type returned by `create_operation()`."

#: ../../source/module/custom-card-development.md:148
#: 269853ae0c0c4d5cb53017e9032c3dc8
msgid "**禁止在 UI 里写算法**：`init_ui()` 只建控件，`get_params()` 只读值，算法全在 Operation 里。"
msgstr ""
"**Do not put algorithms in the UI.** `init_ui()` constructs widgets, "
"`get_params()` reads values, and the Operation owns all computation."

#: ../../source/module/custom-card-development.md:149
#: aa599dc4e593490283201bccc0d8d5e7
msgid ""
"**`process_structure()` 不新增**：如果要保留旧兼容层，只做一行委托 `return "
"self.create_operation().run_structure(structure, self.get_params())`。"
msgstr ""
"**Do not add a new `process_structure()` implementation.** If an existing"
" compatibility method must remain, reduce it to one delegation line: "
"`return self.create_operation().run_structure(structure, "
"self.get_params())`."

#: ../../source/module/custom-card-development.md:150
#: f6767d8a733a41e0858f468a8a8c93b2
msgid ""
"数值参数用 `SpinBoxUnitInputFrame`，枚举用 `ComboBox`，开关用 `CheckBox`，字符串用 "
"`LineEdit`。"
msgstr ""
"Use `SpinBoxUnitInputFrame` for numeric values, `ComboBox` for "
"enumerations, `CheckBox` for switches, and `LineEdit` for strings."

#: ../../source/module/custom-card-development.md:152
#: 4d6abd764e91409b8454ce7a791931cb
msgid "第五步：注册、文档、测试"
msgstr "Step 5: Register, document, and test the card"

#: ../../source/module/custom-card-development.md:154
#: f49fd02019c142ccb4039d2485e77b61
msgid "`@CardManager.register_card` 装饰 UI 类。"
msgstr "Decorate the UI class with `@CardManager.register_card`."

#: ../../source/module/custom-card-development.md:155
#: dadcf0bc2f324eb2a2953539cfa2c1d9
msgid "在 `src/NepTrainKit/ui/views/_card/__init__.py` 导入并加入 `__all__`。"
msgstr ""
"Import the class in `src/NepTrainKit/ui/views/_card/__init__.py` and add "
"it to `__all__`."

#: ../../source/module/custom-card-development.md:156
#: d384576a5cc34beca9af01c31d980c39
msgid ""
"写文档页 `docs/source/module/make-dataset-cards/cards/my-"
"card.md`，操作示例必须从训练集诊断场景出发：先说用户遇到什么训练集问题，再说明这张卡如何补结构。参见 [卡片文档编写规范](make-"
"dataset-cards/writing-guide.md)。"
msgstr ""
"Add `docs/source/module/make-dataset-cards/cards/my-card.md`. Start its "
"example from a diagnosed training-set problem, then explain how the card "
"adds the missing structures. See the [card documentation guide](make-"
"dataset-cards/writing-guide.md)."

#: ../../source/module/custom-card-development.md:157
#: b5b7f017a5cf4a2bac3f3b5d6e9487d8
msgid "写 operation 测试（不需要 Qt）："
msgstr "Write operation tests that do not require Qt:"

#: ../../source/module/custom-card-development.md:158
#: 169759b67cc346b3afd07c30451d7045
msgid ""
"def test_my_card_operation():\n"
"    op = MyCardOperation()\n"
"    result = op.run_structure(test_atoms, MyCardParams(param_b=2.0))\n"
"    assert len(result) > 0\n"
msgstr ""
"def test_my_card_operation():\n"
"    op = MyCardOperation()\n"
"    result = op.run_structure(test_atoms, MyCardParams(param_b=2.0))\n"
"    assert len(result) > 0\n"

#: ../../source/module/custom-card-development.md:165
#: 4d27929979fb4dfb9528a32f565206ac
msgid "验证"
msgstr "Validate"

#: ../../source/module/custom-card-development.md:167
#: baff1b34397b4517810bf484f97d6056
msgid ""
"python skills/make-dataset-card-dev/scripts/run_card_checks.py --quick\n"
"python tools/docs/audit_card_docs.py\n"
msgstr ""
"python skills/make-dataset-card-dev/scripts/run_card_checks.py --quick\n"
"python tools/docs/audit_card_docs.py\n"

#: ../../source/module/custom-card-development.md:172
#: 2170c0b47fd9439c95aa33adf286e535
msgid "放置自定义卡片"
msgstr "Install an external card"

#: ../../source/module/custom-card-development.md:174
#: c763829fbcf54bc5b234d72cf6becad4
msgid ""
"内置卡片放在 `src/NepTrainKit/ui/views/_card/`。外部自定义卡片放在用户配置目录的 `cards/` "
"子目录下，程序启动时会自动加载。"
msgstr ""
"Built-in cards live in `src/NepTrainKit/ui/views/_card/`. Put an external"
" custom card in the `cards/` subdirectory of the user configuration "
"directory; NepTrainKit discovers it at startup."

