#: ../../source/module/custom-card-development.md:39
#: 14243f39f96f40b6b3fe89a016383177
msgid ""
"from dataclasses import dataclass\n"
"\n"
"@dataclass(frozen=True)\n"
"class MyCardParams:\n"
"    \"\"\"Parameters for my card.\"\"\"\n"
"    param_a: str = \"default\"\n"
"    param_b: float = 1.0\n"
"    use_seed: bool = False\n"
"    seed: int = 0\n"
msgstr ""

