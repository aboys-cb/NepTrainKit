#: ../../source/module/make-dataset-cards/cards/bain-path-card.md:151
#: 637d7a48735e4d2c9a140abd7c4cf8be
msgid "可复现性"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/bain-path-card.md:153
#: 9170842fd6c5498481162ee2bff19eaf
msgid "无随机性。同一输入结构和同一参数会生成完全一致的结构列表。"
msgstr ""
