"{\n"
"  \"class\": \"CellScalingCard\",\n"
"  \"check_state\": true,\n"
"  \"params\": {\n"
"    \"engine_type\": 0,\n"
"    \"max_scaling\": 0.02,\n"
"    \"max_num\": 30,\n"
"    \"perturb_angle\": false,\n"
"    \"identify_organic\": false,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 42\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/cell-scaling-card.md:101
#: c5a6843bf4ee4797b9e7031083daa331
msgid "热膨胀 + 角度覆盖（max_scaling=5%，长度+角度，50 样本）"
msgstr "Thermal expansion plus angle coverage (5%, lengths and angles, 50 samples)"

#: ../../source/module/make-dataset-cards/cards/cell-scaling-card.md:102
#: 03f021cb81ad476f9df04a4441bcaf99
