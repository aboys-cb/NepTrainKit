"  \"x_range\": [-1, 1, 1],\n"
"  \"y_range\": [-1, 1, 1],\n"
"  \"z_range\": [-1, 1, 1]\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/cell-strain-card.md:85
#: 3ab6086422e44afb8808787e3722d0c0
msgid "各向异性弹性（uniaxial ±3%，三个方向各 7 个点）"
msgstr "Anisotropic elasticity (uniaxial ±3%, seven points per direction)"

#: ../../source/module/make-dataset-cards/cards/cell-strain-card.md:86
#: 4dda3956ec604603b1ca13daa7c993e2
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"CellStrainCard\",\n"
"  \"check_state\": true,\n"
"  \"organic\": false,\n"
"  \"engine_type\": \"uniaxial\",\n"
"  \"x_range\": [-3, 3, 1],\n"
"  \"y_range\": [-3, 3, 1],\n"
"  \"z_range\": [-3, 3, 1]\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/cell-strain-card.md:98
#: f027b2f4d7514f6ea7426a3eda3aa029
msgid "全方向覆盖（biaxial ±6%，适合怀疑模型在大变形下崩溃）"
msgstr ""
"Broad directional coverage (biaxial ±6%, for diagnosing failure under large "
"deformation)"

#: ../../source/module/make-dataset-cards/cards/cell-strain-card.md:99
#: 31e9849da67f412c93048adb56ed8a0f
#, python-brace-format
