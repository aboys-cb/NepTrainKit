msgstr ""
"{\"B\":{\"elements\":[\"Al\",\"Ni\"],\"mode\":\"fraction_range\",\"fractions\":{\"Al\":[0.25,0.75],\"Ni\":[0.25,0.75]}}}"
"\n"

#: ../../source/module/make-dataset-cards/cards/finite-cell-alloy-occupancy-card.md:59
#: e3b15dcc73d442e5817bdaa63ae8d244
msgid "整数范围示例："
msgstr "Integer-count-range example:"

