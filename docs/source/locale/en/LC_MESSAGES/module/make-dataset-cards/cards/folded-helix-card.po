#: ../../source/module/make-dataset-cards/cards/folded-helix-card.md:139
#: 27893757b1ce416ca9e739ec9b2eca7b
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"FoldedHelixCard\",\n"
"  \"check_state\": true,\n"
"  \"layer_axis\": [0.0, 0.0, 1.0],\n"
"  \"plane_normal\": [0.0, 0.0, 1.0],\n"
"  \"layer_tolerance\": [0.03],\n"
"  \"half_period_mode\": \"Auto from layer count\",\n"
