#: ../../source/module/make-dataset-cards/cards/folded-helix-card.md:54
#: 88d0438dd09149ae92f48e3bd4b93ec5
msgid "需要标准单向传播的螺旋 → 用 `Spin Spiral`"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/folded-helix-card.md:55
