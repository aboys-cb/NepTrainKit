msgid "`Grp({分组模式},{A标签}/{B标签})`"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/group-label-card.md:148
#: b9a2f10ab0e64a75b6df7a063b86ff0c
msgid "写入 `atoms.arrays['group']`，每个原子值为 group_a 或 group_b 字符串。"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/group-label-card.md:150
#: 60861de0b7c949f5858a3be9e1b4e5cd
msgid "可复现性"
msgstr ""

