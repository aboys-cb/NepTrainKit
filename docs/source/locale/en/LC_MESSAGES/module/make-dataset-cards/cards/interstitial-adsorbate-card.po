#: 04f0ba43b2494c309746607eed7b7f42
msgid "什么时候加这张卡、什么时候不加"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/interstitial-adsorbate-card.md:41
#: fe14b64ca55b4c93b720e757ad4b17df
msgid "**加：**"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/interstitial-adsorbate-card.md:42
#: 6efae16378064b7ebd0c5a4c761a9fd2
msgid "模型对扩散、吸附、插层位点预测不准"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/interstitial-adsorbate-card.md:43
#: 9281cfeb58934ff39f1d5695899254a0
msgid "训练集只有完美晶格占据，缺少间隙原子环境"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/interstitial-adsorbate-card.md:44
#: e3e5100a48c4400990142012207ee925
msgid "研究表面催化、电池材料离子输运"
