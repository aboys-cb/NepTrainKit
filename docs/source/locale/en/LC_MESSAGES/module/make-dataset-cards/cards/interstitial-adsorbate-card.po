#: 0b0b813735764bc2a239122365e98daa
msgid "`Random Slab` → `Insert Defect`：先切表面 slab，再加吸附原子"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/interstitial-adsorbate-card.md:171
#: ac754936505a419692dc7cad5166856f
msgid "`Insert Defect` → `Random Vacancy`：互补缺陷族（间隙 + 空位）"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/interstitial-adsorbate-card.md:172
#: e2d0cc59468449d4a59f16fa4a89a7af
