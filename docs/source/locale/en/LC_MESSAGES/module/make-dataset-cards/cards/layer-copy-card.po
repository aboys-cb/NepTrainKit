msgstr ""

#: ../../source/module/make-dataset-cards/cards/layer-copy-card.md:41
#: 8c607a652b48476abda33b2b1c272392
msgid "研究二维材料、层状材料（MoS2、石墨、BN）的多层性质"
msgstr ""

