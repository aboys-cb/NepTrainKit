#~ msgid "推荐组合"
#~ msgstr "Recommended combinations"

#~ msgid "`Super Cell → Layer Copy`：先扩大面内尺寸，再沿 z 堆叠。"
#~ msgstr "`Super Cell → Layer Copy`: enlarge the in-plane cell first, then stack along z."

