msgstr ""

#: ../../source/module/make-dataset-cards/cards/local-solvation-card.md:156
#: 5f1481bb8be04e38af8ecd41795ead89
msgid "表面含水局部环境（按 z 选中心，允许部分输出）"
msgstr ""

