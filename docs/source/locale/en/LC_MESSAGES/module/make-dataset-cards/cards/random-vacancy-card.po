"    \"rules\": [\n"
"      {\"element\": \"O\", \"count_mode\": \"random\", \"count\": [1, 3], "
"\"group\": [\"surface\"]},\n"
"      {\"element\": \"Li\", \"count_mode\": \"fixed\", \"count\": [1, 1], "
"\"group\": [\"surface\"]}\n"
"    ],\n"
"    \"max_structures\": 20,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 42\n"
"  }\n"
