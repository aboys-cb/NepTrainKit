msgstr "Single-element single vacancy (two outputs for rule validation)"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/make-dataset-cards/cards/random-vacancy-card.md:105
#: a01f86af344c430ca9512c0bace86274
msgid ""
"{\n"
"  \"class\": \"RandomVacancyCard\",\n"
"  \"check_state\": true,\n"
"  \"params\": {\n"
"    \"rules\": [\n"
"      {\"element\": \"O\", \"count_mode\": \"fixed\", \"count\": [1, 1]}\n"
"    ],\n"
"    \"max_structures\": 2,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 42\n"
"  }\n"
"}\n"
msgstr ""

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/make-dataset-cards/cards/random-vacancy-card.md:120
#: ee014f41e41b4acf93ff15ef53334fbd
msgid "单元素低浓度空位（20 个输出，常规覆盖）"
msgstr "Low-concentration single-element vacancies (20 outputs)"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/make-dataset-cards/cards/random-vacancy-card.md:121
#: 6364d9d294054636991dadf0e0441a51
msgid ""
"{\n"
"  \"class\": \"RandomVacancyCard\",\n"
"  \"check_state\": true,\n"
"  \"params\": {\n"
"    \"rules\": [\n"
"      {\"element\": \"O\", \"count_mode\": \"random\", \"count\": [1, 3]}\n"
"    ],\n"
"    \"max_structures\": 20,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 42\n"
"  }\n"
"}\n"
msgstr ""

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/make-dataset-cards/cards/random-vacancy-card.md:136
#: 2ae2830ef38b4712ae348c160713c463
msgid "多元素带 group 约束（20 个输出，表面定向空位）"
msgstr "Multiple rules with group constraints (20 targeted surface outputs)"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/make-dataset-cards/cards/random-vacancy-card.md:137
#: 619d34bb4cbd4b60b3333b9a724de77b
