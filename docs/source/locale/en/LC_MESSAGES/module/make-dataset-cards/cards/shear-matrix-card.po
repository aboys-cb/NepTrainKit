"{\n"
"  \"class\": \"ShearMatrixCard\",\n"
"  \"check_state\": true,\n"
"  \"xy_range\": [-5, 5, 1],\n"
"  \"yz_range\": [-5, 5, 1],\n"
"  \"xz_range\": [0, 0, 1],\n"
"  \"symmetric\": true,\n"
"  \"identify_organic\": false\n"
"}\n"
msgstr ""

