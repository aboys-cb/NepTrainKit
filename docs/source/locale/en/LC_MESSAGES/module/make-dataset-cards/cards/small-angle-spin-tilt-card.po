msgstr ""

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/make-dataset-cards/cards/small-angle-spin-tilt-card.md:38
#: 79799d3f22ec484a880cb619e7b0aaff
msgid "`近邻壳层`（`pair_shell`） = `[1]`"
msgstr "This section explains the option, its parameters, operation, and expected result."

