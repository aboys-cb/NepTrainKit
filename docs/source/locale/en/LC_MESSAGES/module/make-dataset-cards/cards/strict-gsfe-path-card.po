"    \"slip_uvw\": [1, 0, 0],\n"
"    \"displacement_range\": [0.0, 1.0, 0.1],\n"
"    \"displacement_unit\": \"fraction_of_vector\",\n"
"    \"cut_mode\": \"middle\",\n"
"    \"cut_fraction\": 0.5,\n"
