msgid "**输出结构数远少于预期。** 空位数为 0 时不会生成。检查浓度模式下 `concentration * n_atoms` 是否≥1。"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/vacancy-defect-card.md:162
#: cf8e869996dd43c384d16ceadc999bae
