#: 137eef2ff6b34add8f3c1d9c783f9aa5
#, python-brace-format
msgid "`Vib(a={amplitude},m={modes_per_sample})`"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md:196
#: 1690c24c3a044872a42125a2342bf8c9
msgid "可复现性"
msgstr "Reproducibility"

#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md:198
#: eeef08c912c448d7bdae9431e7e9e8cc
msgid "勾选 `use_seed` + 固定 `seed` → 相同输入可复现。模态选择、系数采样均受 seed 控制。"
msgstr ""
"Enable `use_seed` and fix `seed` to reproduce the same result for the same "
"input. The seed controls both mode selection and coefficient sampling."
