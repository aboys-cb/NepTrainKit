msgstr ""

#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md
#: c18aa5ee7d8a4332b45ca4b768c00e91
msgid "`(2.3, 0.0, 0.0)`"
msgstr ""

#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md
#: b51637ef868942a2b0a90f6c4e1a532d
msgid "`(-0.10, 0.00, 0.00)`"
