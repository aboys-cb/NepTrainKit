#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md:166
#: 56c873df8de74bd78bd107f7f1cfc068
msgid "`Config_type` 追加 `Vib(a=<尺度>,m=<模式数>)`；"
msgstr "`Vib(a=<scale>,m=<mode count>)` is appended to `Config_type`;"

#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md:167
#: 302060728f4d47b1b554a6c8ceb9ba6d
msgid "`vibration_mode_perturb` metadata 记录参数、候选模式数、所选模式位置、对应频率、seed 和样本序号；"
msgstr ""
"the `vibration_mode_perturb` metadata records parameters, candidate-mode count, "
"selected mode positions, corresponding frequencies, seed, and sample index;"

#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md:168
#: aa2fa3bb1261463e804a41e0bd8ee5c1
msgid "相同结构、参数和 seed 得到相同结果；不同结构从同一基准 seed 派生不同随机流。"
msgstr ""
"the same structure, parameters, and seed produce the same results, while different "
"structures derive different random streams from the same base seed."

#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md:170
#: 793458517aee47db8aacd60c03c2c2b0
msgid "metadata 中的模式位置是“筛选后候选模式列表”的零基序号。"
msgstr ""
"Mode positions in the metadata are zero-based indices into the candidate-mode list "
"after filtering."

#: ../../source/module/make-dataset-cards/cards/vibration-perturb-card.md:175
