#: 1aa969d1cee04bef9ed0ee8d0dc5bf54 ae4bb27ca9c24f94be814fc0fa39cb68
msgid "输入假设"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:24
#: deb5e02b4204453cbcea9d600dd1fbe4
msgid "已有一个体相母相结构，或者先用 `Crystal Prototype Builder` 生成基础结构。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:25
#: fe790a2a443d486eaa887de23e5d9ad4
msgid "目标元素集合为 `Co,Cr,Ni,Al,Fe`。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:26
