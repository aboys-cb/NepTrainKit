#: ../../source/module/make-dataset-cards/recipes.md:30
#: 536edfb89bb84edf8d69112a273a3280
msgid ""
"`Crystal Prototype Builder → Composition Sweep → Random Occupancy → "
"Random Doping → 导出 xyz → NEP Dataset Display 清洗 → FPS`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:32
#: ../../source/module/make-dataset-cards/recipes.md:149
#: ../../source/module/make-dataset-cards/recipes.md:257
#: ../../source/module/make-dataset-cards/recipes.md:326
#: ../../source/module/make-dataset-cards/recipes.md:425
#: 0aad355ffff944bebb9e0907ea052d84 837a8fc6a9144298a3f9d1a875c2e1fa
msgid "每步 JSON 配置"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:34
#: ../../source/module/make-dataset-cards/recipes.md:259
#: 2691bbe7f5144633844950a25d2ae762 62cb6c651f954c7abcb76db046e56bca
msgid "Step 1. `Crystal Prototype Builder`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:36
#: 6962a1dac0be486b99aa99ec0026fae4
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"CrystalPrototypeBuilderCard\",\n"
"  \"params\": {\n"
"    \"lattice\": \"fcc\",\n"
"    \"element\": \"Ni\",\n"
"    \"a_range\": [3.52, 3.52, 0.1],\n"
"    \"covera\": 1.633,\n"
"    \"auto_supercell\": true,\n"
"    \"max_atoms\": 64,\n"
"    \"rep\": [2, 2, 2],\n"
"    \"max_outputs\": 1\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:52
#: 4083dd17e1e9416f9dc2a3309ae52278
msgid "**每步预期输出：** 1 个基础 fcc 结构；原子数受 `max_atoms` 控制，适合作为后续配比扫描母体。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:54
#: a477f509c7f445c8af0a13e5a8d108cd
msgid "Step 2. `Composition Sweep`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:56
#: c3538cba149f4786b605f96ee2b79d67
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"CompositionSweepCard\",\n"
"  \"params\": {\n"
"    \"elements\": \"Co,Cr,Ni,Al,Fe\",\n"
"    \"order\": \"4,5\",\n"
"    \"method\": \"Sobol\",\n"
"    \"step\": 0.1,\n"
"    \"n_points\": 24,\n"
"    \"min_fraction\": 0.05,\n"
"    \"include_endpoints\": true,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 42,\n"
"    \"max_outputs\": 24,\n"
"    \"budget_mode\": \"Equal+Reflow\"\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:75
#: 27fef699267d43dcb7e824660db85f2e
msgid "**每步预期输出：** 24 个带 `Comp(...)` 标签的目标配比结构副本；此时还没有真正替换原子位点。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:77
#: 8b7f34fc3b884817a1f6a41ffaadd3f1
msgid "Step 3. `Random Occupancy`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:79
#: a6fa508b8d9c417185c12de76041fbcf
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"RandomOccupancyCard\",\n"
"  \"params\": {\n"
"    \"source\": \"Auto (Comp tag)\",\n"
"    \"manual\": \"\",\n"
"    \"mode\": \"Exact\",\n"
"    \"samples\": 2,\n"
"    \"group_filter\": \"\",\n"
"    \"use_seed\": true,\n"
"    \"seed\": 42\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:94
#: ef6ce1cf103540d18a538723ba792dd7
msgid "**每步预期输出：** 每个目标配比落点成 2 个离散占位结构；如果 Step 2 输出 24 个配比点，这一步通常得到约 48 个随机合金候选。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:96
#: 8daf8079195f436b9bc13eac962921e1
msgid "Step 4. `Random Doping`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:98
#: 2f01582d2b8b41fb922e8dc20c9144ec
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"RandomDopingCard\",\n"
"  \"params\": {\n"
"    \"rules\": [\n"
"      {\n"
"        \"target\": \"Ni\",\n"
"        \"dopants\": {\"Co\": 1.0, \"Cr\": 1.0},\n"
"        \"use\": \"count\",\n"
"        \"count_mode\": \"random\",\n"
"        \"count\": [1, 2],\n"
"        \"percent\": [0.0, 1.0]\n"
"      }\n"
"    ],\n"
"    \"doping_type\": \"Exact\",\n"
"    \"max_structures\": 2,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 123\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:120
#: 6e560996bfe64b9eb42fca7238b9c4f4
msgid "**每步预期输出：** 对每个离散占位结构再扩出 2 个局部替换版本，进一步增加局部环境多样性。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:122
#: ../../source/module/make-dataset-cards/recipes.md:229
#: ../../source/module/make-dataset-cards/recipes.md:299
#: ../../source/module/make-dataset-cards/recipes.md:398
#: ../../source/module/make-dataset-cards/recipes.md:478
#: 1b739e5d858744b6b7a3dec9173a33d1
msgid "最终数据集特征"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:124
#: 28039fef63614974b7ee1e9c8ceada00
msgid "同时覆盖四元和五元目标配比"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:125
#: 0d86828b1b224a198ae8853f042f4760
msgid "每个目标配比都落到了实际原子位点"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:126
#: d0f94e956418405f8b0ab27031ec92ab
msgid "局部化学环境不只来自占位，还来自额外随机替换"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:128
#: ../../source/module/make-dataset-cards/recipes.md:235
#: ../../source/module/make-dataset-cards/recipes.md:305
#: ../../source/module/make-dataset-cards/recipes.md:404
#: ../../source/module/make-dataset-cards/recipes.md:484
#: 37b2c427b82e4f8da9f57f2b46888417
msgid "常见失败点"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:130
#: 8da1731cb4e54ab5b54fa119623e462e
msgid "只做 `Composition Sweep` 就停止：这只定义目标配比，不代表已经得到真实随机合金。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:131
#: 93553b79cdc54490ab1cb08deab4c9a0
msgid "`Random Occupancy` 的 `source` 没有读取 `Comp(...)`：会导致输出与目标配比不一致。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:132
#: 0b04cc7acc7145199dc222261c9b18e3
msgid "`Random Doping` 规则写得过重：容易把原本的目标配比拉偏。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:134
#: bbc76276e37e4d99ac9894cfec564501
msgid "富缺陷表面"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:138
#: 38679bb79f264f8bb23b6b246b633f59
msgid "从体相结构构造多取向表面，再在表面上加入插隙/吸附和空位，得到既有表面效应又有缺陷效应的数据集。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:142
#: c10904cfe2ce4fc28fa1c7a26cfa1ce8
msgid "输入是已弛豫的体相晶体。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:143
#: 3e516008835e4cb79d97c6554bb80854
msgid "目标任务是表面反应、表面稳定性或富缺陷 slab 训练。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:147
#: d99688b9f4d74b8881a3bbeb69b8af50
msgid ""
"`Super Cell → Random Slab → Insert Defect → Vacancy Defect Generation → "
"导出 xyz → NEP Dataset Display 清洗 → FPS`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:151
#: 628422708747444498d1bbc1564c907e
msgid "Step 1. `Super Cell`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:153
#: 1eea52c36f1e477196e0805e330fd452
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"SuperCellCard\",\n"
"  \"params\": {\n"
"    \"behavior_type\": 0,\n"
"    \"mode\": \"scale\",\n"
"    \"super_scale\": [2, 2, 1],\n"
"    \"target_cell\": [20.0, 20.0, 20.0],\n"
"    \"max_atoms\": 200,\n"
"    \"fixed_axis_flags\": [false, false, true],\n"
"    \"fixed_axis_scale\": [1, 1, 1]\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:168
#: 781485e116e7401d969ece3620618c71
msgid "**每步预期输出：** 1 个横向扩展、法向保持 1 倍的母相结构；适合作为表面切片前的体相输入。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:170
#: 8f0b17c66c8242b68ef1f9855266e9ab
msgid "Step 2. `Random Slab`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:172
#: 2d65badd5c1841a785d3d2397da6f691
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"RandomSlabCard\",\n"
"  \"params\": {\n"
"    \"h_range\": [0, 1, 1],\n"
"    \"k_range\": [0, 1, 1],\n"
"    \"l_range\": [1, 3, 1],\n"
"    \"layer_range\": [4, 8, 1],\n"
"    \"vacuum_range\": [12, 18, 2]\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:185
#: da48117d126346e8806e3d9fcfa9cca5
msgid "**每步预期输出：** 多个低指数到中低指数 slab；真空层足够隔离上下表面，输出通常已经明显多于 Step 1。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:187
#: 0d2afe944b374b82be75f21582806d84
msgid "Step 3. `Insert Defect`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:189
#: 4636ab28517c43699b4eaffbdf17e132
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"InsertDefectCard\",\n"
"  \"params\": {\n"
"    \"mode\": 1,\n"
"    \"species\": \"H,O\",\n"
"    \"insert_count\": 1,\n"
"    \"structure_count\": 2,\n"
"    \"min_distance\": 1.2,\n"
"    \"max_attempts\": 50,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 7,\n"
"    \"axis\": 2,\n"
"    \"offset\": 1.5\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:207
#: 6ce47059859849a4a3913d5905cff49b
msgid "**每步预期输出：** 每个 slab 表面再分出 2 个带表面吸附或插隙的候选结构。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:209
#: a00182dc95a94724a5da8ce96403582a
msgid "Step 4. `Vacancy Defect Generation`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:211
#: 9d77049168924f388ab61c05b41d1280
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"VacancyDefectCard\",\n"
"  \"params\": {\n"
"    \"engine_type\": 1,\n"
"    \"num_condition\": 1,\n"
"    \"use_num\": false,\n"
"    \"concentration_condition\": 0.03,\n"
"    \"count_mode\": \"fixed\",\n"
"    \"max_structures\": 3,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 19\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:227
#: f7cc396fb3484134a9db5501ec240d3a
msgid "**每步预期输出：** 每个已有表面缺陷结构再扩出约 3 个轻度空位版本；空位强度受浓度控制，而不是固定删位数。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:231
#: 6816c27d65d24495bdfe1eaff50fc2ae
msgid "同时覆盖不同 slab 取向、厚度和真空层"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:232
#: b86870c0df8748b7999d360a77ab93cd
msgid "既有表面，也有插隙/吸附和空位"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:233
#: b0c0c92db1d945e190642284f5a914ff
msgid "缺陷强度可控，适合做表面缺陷多样性训练"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:237
#: 344ecbf47e1743fd88e70dcee1ffc13c
msgid "先做空位再做 slab：会把“体相删位”误当成“表面缺陷”。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:238
#: 9c2078c29c414192903d679a6c0e939a
msgid "`vacuum_range` 过小：上下表面镜像相互作用会污染结果。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:239
#: 6619b2adb1254d7eabdd4de008f72ef9
msgid "`concentration_condition` 设得过大：slab 太薄时容易直接破坏表面骨架。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:241
#: f8d9892adf584ac88abea8ae99a0dc82
msgid "GSFE 路径"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:245
#: 4d6e91dc81bb4732abe0bc625a13fbba
msgid ""
"为指定滑移系统生成一条未弛豫 GSFE 路径。这个配方适合模型在层错能、滑移势垒或局部极小位置上明显偏离 "
"DFT，而训练集中又缺少系统层间错排结构的情况。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:249
#: 94b4c8a3ed334a489ed465e2303017e3
msgid "研究对象是 fcc 金属或近 fcc 合金。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:250
#: eb2873d99ba54c85974b6d22b2f16acd
msgid "目标是先扫 fcc (111) 面内完整周期路径，而不是生成带真空的自由表面。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:251
#: 854d46df128c436ca812b1add611fb44
msgid "后续会对输出结构做 DFT 单点或短弛豫，再加入训练集。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:255
#: c0283b21213946068483894ad6537789
msgid ""
"`Crystal Prototype Builder(fcc111) → Strict GSFE Path → 导出 xyz → NEP "
"Dataset Display 清洗 → DFT`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:261
#: 031e80c966214f059edbcc58ed53c5ed
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"CrystalPrototypeBuilderCard\",\n"
"  \"params\": {\n"
"    \"lattice\": \"fcc111\",\n"
"    \"element\": \"Ni\",\n"
"    \"a_range\": [3.60, 3.60, 0.1],\n"
"    \"covera\": 1.633,\n"
"    \"auto_supercell\": false,\n"
"    \"max_atoms\": 256,\n"
"    \"rep\": [2, 2, 2],\n"
"    \"max_outputs\": 1\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:277
#: 054702fc78a74c1c98aa8e60dd3757ed
msgid ""
"**每步预期输出：** 1 个 slab-oriented 周期 cell。当前 cell 的 `(001)` 面对应原始 fcc 的 "
"`(111)` 面，第三晶胞方向已经垂直于层错面。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:279
#: b5367a03960e42eeba80f179284aa431
msgid "Step 2. `Strict GSFE Path`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:281
#: 1881b7f1d4be451fa62fb3ba2989e027
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"StrictGSFEPathCard\",\n"
"  \"params\": {\n"
"    \"plane_hkl\": [0, 0, 1],\n"
"    \"slip_uvw\": [1, 0, 0],\n"
"    \"displacement_range\": [0.0, 1.0, 0.1],\n"
"    \"displacement_unit\": \"fraction_of_vector\",\n"
"    \"cut_mode\": \"middle\",\n"
"    \"cut_fraction\": 0.5,\n"
"    \"layer_index\": 0,\n"
"    \"wrap\": true\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:297
#: 696de8e969fd47a8802125bdc303c92a
msgid "**每步预期输出：** 11 个沿面内周期方向滑移的层错结构。第一个和最后一个结构应回到同一个周期位置，中间结构用于 DFT 标注 GSFE 曲线。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:301
#: acd107cac28d48bc84d692e01a26d84e
msgid "覆盖完整滑移周期，而不是单个任意层错位移"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:302
#: 214b7faaeaf94899b377e37edeb22213
msgid "输出标签里保留 `hkl`、`uvw` 和位移量，方便回看曲线"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:303
#: 5e04c63d847f4457ae3bf6e96f805188
msgid "输入几何满足 slab-oriented 要求，避免普通 cubic cell 直接扫 `(111)` 时产生错接"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:307
#: 7d73cb352ece47ae92d25978e21b1dac
msgid ""
"直接把普通 `fcc` cubic cell 送进 `Strict GSFE Path`：第三晶胞方向不垂直于目标 `(111)` 面，程序会报 "
"slab-oriented 错误。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:308
#: 86c6e775f3304f99b6001ac9d03fc409
msgid "把这里的 `fcc111` 当成真空表面：它是周期 cell，不含真空层；如果要自由表面，用 `Random Slab`。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:309
#: 1e5a7c3e6293460f9785fd9e21141d7b
msgid "位移步长太粗：0.1 适合第一轮覆盖；如果峰值附近曲线不平滑，把步长缩到 0.05。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:311
#: 0be6981f59654037a0ce4e168451743c
msgid "磁性数据"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:315
#: a8e16e5511bd46fdb315a9691b3165e9
msgid "从一个磁性母相结构出发，先写入分组标签，再生成 FM / AFM / PM 分支，最后对已有磁矩做旋转补样。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:319
#: 3ea44ae6d81644c5a8ac514ffd9a3c72
msgid "输入结构是磁性材料。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:320
#: 9d0dd185850a4f38baef523e3d107dd3
msgid "你希望同时覆盖多磁序，而不是只保留单一 MAGMOM 初始化。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:324
#: 9536516c277b454d9a8f5306b3aaed5e
msgid "`Group Label → Magnetic Order → Magmom Rotation`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:328
#: b438fdaa59e74b0985c0ac9764f95947
msgid "Step 1. `Group Label`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:330
#: efe14a577ad044198ed4ee55fbb440bc
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"GroupLabelCard\",\n"
"  \"params\": {\n"
"    \"mode\": \"k-vector layers (recommended)\",\n"
"    \"kvec\": \"111\",\n"
"    \"group_a\": \"A\",\n"
"    \"group_b\": \"B\",\n"
"    \"overwrite\": true\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:343
#: 4196d368a1664d39b5d67632542842c0
msgid ""
"**每步预期输出：** 1 个带 `group` 数组的结构；后续 `Magnetic Order` 若走 `group A/B` "
"模式会直接使用这些标签。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:345
#: df163a02008f46cb8de238d92b1703a2
msgid "Step 2. `Magnetic Order`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:347
#: b157dd8dfa324b4587e9c32c38e2ac6a
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"MagneticOrderCard\",\n"
"  \"params\": {\n"
"    \"format\": \"Collinear (scalar)\",\n"
"    \"axis\": [0.0, 0.0, 1.0],\n"
"    \"magmom_map\": \"Fe:2.2\",\n"
"    \"use_element_dirs\": false,\n"
"    \"default_moment\": 0.0,\n"
"    \"apply_elements\": \"Fe\",\n"
"    \"gen_fm\": true,\n"
"    \"gen_afm\": true,\n"
"    \"afm_mode\": \"group A/B\",\n"
"    \"afm_kvec\": \"111\",\n"
"    \"afm_group_a\": \"A\",\n"
"    \"afm_group_b\": \"B\",\n"
"    \"afm_zero_unknown\": true,\n"
"    \"gen_pm\": true,\n"
"    \"pm_count\": 8,\n"
"    \"pm_direction\": \"sphere\",\n"
"    \"pm_cone_angle\": 30.0,\n"
"    \"pm_balanced\": true,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 88\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:375
#: 0c1dcddf17ee40548ec25eee6e6e1060
msgid ""
"**每步预期输出：** 至少得到 1 个 FM、1 个 AFM 和 8 个 PM 候选；如果 `afm_mode` 设为 `group "
"A/B`，真正起作用的是 `afm_group_a/b`，不是 `afm_kvec`。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:377
#: 77c93404fc864455b2e61da2eff71366
msgid "Step 3. `Magmom Rotation`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:379
#: 7cc8b87236224ef292aad435708d1e1a
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"MagneticMomentRotationCard\",\n"
"  \"params\": {\n"
"    \"elements\": \"Fe\",\n"
"    \"max_angle\": 15.0,\n"
"    \"num_structures\": 3,\n"
"    \"lift_scalar\": true,\n"
"    \"axis\": [0.0, 0.0, 1.0],\n"
"    \"disturb_magnitude\": false,\n"
"    \"magnitude_factor\": [1.0, 1.0],\n"
"    \"use_seed\": true,\n"
"    \"seed\": 99\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:396
#: 67fe06ba53eb4d988b8251b2270028c4
msgid "**每步预期输出：** 对每个已有磁序结构再扩出 3 个小角度旋转版本，适合补充非共线附近样本。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:400
#: 4fa2f2c9a4b14319a341ad44675403ff
msgid "同时包含 FM、AFM、PM 和小角度旋转分支"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:401
#: 361bd4fee5cc4fc5a382a07ef2a9d155
msgid "AFM 的分组来源清晰，可追溯"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:402
#: f313352bace94a52ae1e01c1678bed32
msgid "随机性由 seed 控制，可做重复实验"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:406
#: 9087644f2176409db194560638373c9b
msgid "没有先提供 `magmom_map` 或合理 `default_moment`：生成的磁矩幅值会退化。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:407
#: af789faa031d4db09f8f113b193beeb1
msgid "`afm_mode` 设成 `group A/B` 却没有 `group` 数组：AFM 分支会失去预期分组信息。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:408
#: de4c5605bb3a4d47a0c45eea051a58c7
msgid "直接用 `Magmom Rotation` 处理没有初始磁矩的结构：旋转对象本身就不存在。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:410
#: 01c25f0f31b246498e03f80ffc115720
msgid "有机构象"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:414
#: 3b9b8dfed9a2422f9a337819591d4a51
msgid "为有机分子或分子晶体生成构象样本，再叠加轻微原子扰动，得到更适合 NEP 训练的局部结构分布。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:418
#: fdfe33c1b8c6403ba40ff7cbc18216d2
msgid "输入里包含有机分子，或者是分子晶体。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:419
#: 69928a93aa704160bab710527eb01404
msgid "希望同时覆盖扭转构象和局部热噪声，而不是只做刚性平移。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:423
#: 155d2884181b467f997f787eea0a9144
msgid ""
"`Organic Mol Config → Atomic Perturb → 导出 xyz → NEP Dataset Display 清洗 → "
"FPS`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:427
#: 68a18bada45044a8a823cf5aa891dd96
msgid "Step 1. `Organic Mol Config`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:429
#: 2928c18f24d84c658a55537782db65f4
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"OrganicMolConfigPBCCard\",\n"
"  \"params\": {\n"
"    \"perturb_per_frame\": 8,\n"
"    \"torsion_range_deg\": [-25.0, 25.0],\n"
"    \"max_torsions_per_conf\": 2,\n"
"    \"gaussian_sigma\": 0.01,\n"
"    \"pbc_mode\": \"molecule in box\",\n"
"    \"local_cutoff\": 5,\n"
"    \"local_subtree\": 100,\n"
"    \"bond_detect_factor\": 1.15,\n"
"    \"bond_keep_min_factor\": 0.75,\n"
"    \"bond_keep_max_factor\": 1.30,\n"
"    \"bond_keep_max_enable\": true,\n"
"    \"nonbond_min_factor\": 0.80,\n"
"    \"max_retries\": 50,\n"
"    \"mult_bond_factor\": 1.10,\n"
"    \"nonpbc_box_size\": 20.0,\n"
"    \"bo_c_const\": 0.35,\n"
"    \"bo_threshold\": 0.25,\n"
"    \"use_seed\": true,\n"
"    \"seed\": 5\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:456
#: 77d28414e9d645f4b0fd21ab23fd4cc5
msgid "**每步预期输出：** 每帧输入扩出 8 个构象版本；主变化来自扭转角和局部高斯扰动，而不是晶格变形。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:458
#: dbbbb20268074fe0aeab9784f576e2d5
msgid "Step 2. `Atomic Perturb`"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:460
#: af020845bb66429dbf8bea7924f3749e
#, python-brace-format
msgid ""
"{\n"
"  \"class\": \"PerturbCard\",\n"
"  \"params\": {\n"
"    \"engine_type\": 0,\n"
"    \"max_distance\": 0.03,\n"
"    \"max_num\": 3,\n"
"    \"identify_organic\": true,\n"
"    \"use_element_scaling\": false,\n"
"    \"element_scalings\": {},\n"
"    \"use_seed\": true,\n"
"    \"seed\": 6\n"
"  }\n"
"}\n"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:476
#: e6a7bb3b31654fd48047ee81732bd58a
msgid "**每步预期输出：** 每个有机构象再扩出 3 个轻微原子热扰动版本；`organic=true` 会尽量保持分子内部拓扑不被原子级随机位移破坏。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:480
#: 666bbffb71b64a9c8bf8ae4a50753f54
msgid "同时覆盖扭转构象和局部热噪声"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:481
#: 87f5b7c85f30419eacd7bf99bcd1bc4f
msgid "分子内部键拓扑更容易保持稳定"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:482
#: 57e26e51834649a8af88a400d065136e
msgid "适合作为有机体系初始训练集或补样集"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:486
#: 8a9523bcce6942c5b6c96f4e51d791d0
msgid "`organic` 没开：原子级扰动更容易拉坏分子内部键。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:487
#: be4614ece1e946ae89c94b41ebd7e563
msgid "`torsion_range_deg` 设得太宽：容易生成明显高能或自相交构象。"
msgstr ""

#: ../../source/module/make-dataset-cards/recipes.md:488
#: 3aad7c24ddca42e1b891bb08c4ba4d46
msgid "先做大幅原子扰动再做构象采样：会把构象变化和非物理断键混在一起。"
msgstr ""
