#: ../../source/module/make-dataset-cards/writing-guide.md:66
#: ffea576b035347d282e2bb319bbeecfd
msgid "解释选择时：\"选 Exact 还是 Random 取决于你要不要严格配比\""
msgstr ""
"Explaining a choice: “Choose Exact or Random according to whether the composition "
"must be strict.”"

#: ../../source/module/make-dataset-cards/writing-guide.md:68
#: 70937e5b40a84f738508c6022f534de1
msgid "以下情况不用："
msgstr "Do not force second-person wording into:"

#: ../../source/module/make-dataset-cards/writing-guide.md:69
#: 63623cc9e0864dc3adde110b41f07d4c
msgid "类型和枚举列表：\"`str`，可选 `sphere` 或 `cone`\""
msgstr "Type and enum lists: “`str`; choices are `sphere` and `cone`.”"

#: ../../source/module/make-dataset-cards/writing-guide.md:70
#: 53156c5262a745809d55951e43ead71b
msgid "纯事实陈述：\"PM 默认关闭，因为会显著增大输出规模\""
