msgstr "Sample a tetragonal transformation or GSFE path"

#: ../../source/module/make-dataset.md:16 80e22b2affb44e0fa4db22d34ce7f883
msgid "`Bain Path` / `Strict GSFE Path`"
msgstr ""

#: ../../source/module/make-dataset.md:16 c86005b73c5a493cafffc67e0254e9f3
msgid "补近平衡扰动"
msgstr "Add near-equilibrium perturbations"

#: ../../source/module/make-dataset.md:16 d83f1176a7314cd88f1e5f208636d00c
