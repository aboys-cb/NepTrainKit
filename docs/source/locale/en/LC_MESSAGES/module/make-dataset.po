#: ../../source/module/make-dataset.md:16 e8d0d1b91d8b4875bd0f998f0868a91a
msgid "做合金或占位变化"
msgstr "Vary alloy composition or site occupation"

#: ../../source/module/make-dataset.md:16 2dad59de647a4f269d4e1a1f67a3c302
msgid "`Random Doping` / `Random Occupancy` / `Composition Sweep`"
msgstr ""

#: ../../source/module/make-dataset.md:16 a639f02325044d97a3ebe2e38a1a5494
msgid "做磁性构型"
msgstr "Create magnetic configurations"

#: ../../source/module/make-dataset.md:16 41a7659f43fd4d57938035dc158541ed
