msgstr "Start with"

#: ../../source/module/make-dataset.md:16 5f0b58b6c8c74b238863483c34167b0a
msgid "扩大晶胞"
msgstr "Expand a simulation cell"

#: ../../source/module/make-dataset.md:16 3876c59ea9364b37b6afed924398e9bf
msgid "`Super Cell`"
msgstr ""

#: ../../source/module/make-dataset.md:16 d568e217556a44a2b9b1619a9c27a9b4
msgid "从标准晶体原型开始"
msgstr "Start from a standard crystal prototype"

#: ../../source/module/make-dataset.md:16 505e689b29aa4d37b879ee278930b825
msgid "`Crystal Prototype Builder`"
msgstr ""

#: ../../source/module/make-dataset.md:16 2e689876a8514aaea7601c0651e9d0f6
