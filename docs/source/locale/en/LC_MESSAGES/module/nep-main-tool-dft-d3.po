msgid "界面按钮：`DFT D3`。"
msgstr "界面按钮：`DFT D3`。"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/nep-main-tool-dft-d3.md:5
#: cc6ee79d3dde45e6a5436fbbed0ee945
