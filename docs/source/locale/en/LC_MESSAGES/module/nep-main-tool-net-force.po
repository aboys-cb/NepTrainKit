msgid "操作后检查"
msgstr "Post-operation checks"

#: ../../source/module/nep-main-tool-net-force.md:31
#: af0aedf15015458ca6ecbc7b0354b4d0
msgid "阈值单位为 `eV/Å`，必须大于零。选中后结合结构原子数、计算精度和标签来源判断； 工具只标出超阈值结构，不会修改力标签。"
msgstr ""
"The threshold is in `eV/Å` and must be positive. Interpret selected "
"structures in light of atom count, calculation precision, and label "
"provenance. The tool only flags structures above the threshold; it does "
"not modify force labels."

#~ msgid "默认值：`widget.force_balance_threshold`（缺省 `1e-3`）。"
#~ msgstr "Default: `widget.force_balance_threshold` (fallback `1e-3`)."
