#: 12acdc4cd6ab4385937f90e96d2dc45a
msgid "所列元素必须全部存在，允许还有其他元素"
msgstr "Every listed element must be present; additional elements are allowed"

#: ../../source/module/show-nep-reference.md:60
#: fa32a1556fa14bf3a9644467a21224b6
msgid "`Fe,O` 可匹配 FeO 和 FeOC"
msgstr "`Fe,O` matches FeO and FeOC"

#: ../../source/module/show-nep-reference.md:60
#: 322a06ba11194093b0dbad39bed7145e
msgid "不得包含元素"
msgstr "Must not contain elements"

#: ../../source/module/show-nep-reference.md:60
#: 2613ba9fc8ad412db5b19495aa48de30
