msgstr "Formula"

#: ../../source/module/show-nep-reference.md:60
#: c7543c5b2617410093bbb102ca4fd8c8
msgid "默认完全等于，也可选择包含或正则匹配"
msgstr ""
"Exact by default; contains and regular-expression matching are also "
"available"

#: ../../source/module/show-nep-reference.md:60
#: 2d8f6ce9d4b94d33aab6ccdedfdfaeb0
