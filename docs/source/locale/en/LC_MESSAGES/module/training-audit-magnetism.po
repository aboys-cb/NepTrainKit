#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/training-audit-magnetism.md:8
#: 9e1aa2154d4e4a4ba44636845d2a17d6
msgid "$C\\ge0.90$、$R_M\\ge0.82$、$\\bar c\\ge0.20$"
msgstr "$C\\ge0.90$, $R_M\\ge0.82$, and $\\bar c\\ge0.20$"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/training-audit-magnetism.md:8
#: 243826b0853e431cb893025dd2b1331a
msgid "AFM"
msgstr "AFM"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/training-audit-magnetism.md:8
#: f2b94f88e1b54436974b4d7edcb22977
#, python-brace-format
msgid ""
"$C\\ge0.90$、$R_M\\le0.20$，并且满足 $S_\\mathrm{max}\\ge0.45$、$\\bar c\\le-0.25$ "
"或反平行近邻比例至少 `0.20` 中的任一项"
msgstr ""
"$C\\ge0.90$ and $R_M\\le0.20$, plus at least one of: "
"$S_\\mathrm{max}\\ge0.45$, $\\bar c\\le-0.25$, or an antiparallel-neighbor "
"fraction of at least `0.20`"

#: ../../../Users/superbing/Desktop/Workspace/NepTrainKit/docs/source/module/training-audit-magnetism.md:8
#: 1c069c3642af439ead8a949c3fed3b8b
