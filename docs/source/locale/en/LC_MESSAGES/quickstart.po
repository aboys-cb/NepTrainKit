msgid "①"
msgstr ""

#: ../../source/quickstart.md:50 9394742b32a541aeb4abb89f8cd3194d
msgid "工作流库"
msgstr "Workflow library"

#: ../../source/quickstart.md:50 472db9ecc0b74ae5b985522e23d7ac8c
msgid "左侧区域，保存、打开和复用整条工作流。"
msgstr "Left panel for saving, opening, and reusing whole workflows."

